{
  "name": "lagless",
  "version": "0.1.1",
  "description": "Low-latency WebRTC data channels for real-time games. Rust (webrtc-rs) native module for Node.js.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stasadance/lagless.git"
  },
  "keywords": [
    "webrtc",
    "datachannel",
    "udp",
    "game",
    "netcode",
    "sctp",
    "napi",
    "rust"
  ],
  "engines": {
    "node": ">= 18"
  },
  "files": [
    "dist",
    "binding.js",
    "binding.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "lagless",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "pnpm build:native && pnpm build:ts",
    "test": "node --test test/*.test.mts",
    "test:soak": "node test/soak.mts",
    "test:rust": "cargo test --release",
    "bench": "node bench/run.mts",
    "build:native": "napi build --platform --release --js binding.js --dts binding.d.ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.11.0",
    "@types/node": "22.20.5",
    "node-datachannel": "0.33.6",
    "playwright": "1.65.1",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-datachannel"
    ]
  }
}
