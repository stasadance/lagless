From ffcef9da7362ce6b0c61d28ff3101c8e5bf54a77 Mon Sep 17 00:00:00 2001
From: Stas Darevskiy <stas@stas.gg>
Date: Sun, 22 Nov 2026 20:12:34 +0000
Subject: [PATCH 3/4] rtc-sctp RACK: don't cut cwnd for losses that won't be
 retransmitted

Unreliable chunks whose retransmit budget is exhausted (maxRetransmits=0) or
whose lifetime expired are abandoned via FORWARD-TSN; their loss no longer
enters fast recovery. Reliable / retryable loss still halves cwnd.
---
 rtc-sctp/src/association/mod.rs        | 18 ++++++++--
 rtc-sctp/src/endpoint/endpoint_test.rs | 49 ++++++++++++++++++++++++++
 2 files changed, 64 insertions(+), 3 deletions(-)

diff --git a/rtc-sctp/src/association/mod.rs b/rtc-sctp/src/association/mod.rs
index ac64a06..346838b 100644
--- a/rtc-sctp/src/association/mod.rs
+++ b/rtc-sctp/src/association/mod.rs
@@ -3438,9 +3438,11 @@ impl Association {
         let reo_wnd = self.rack_reo_wnd(sacked);
         let rack_rtt = self.rack.rtt;
         let mut lost = 0usize;
+        // lost chunks that will actually be retransmitted (reliable / retries left)
+        let mut lost_retransmittable = 0usize;
         let mut earliest: Option<Instant> = None;
         for tsn in tsns {
-            let Some(c) = self.inflight_queue.get_mut(tsn) else { continue };
+            let Some(c) = self.inflight_queue.get(tsn) else { continue };
             if !c.is_outstanding() || c.retransmit {
                 continue;
             }
@@ -3450,8 +3452,14 @@ impl Association {
             }
             let deadline = ls + rack_rtt + reo_wnd;
             if deadline <= now {
-                c.retransmit = true;
+                let exhausted = self.retransmission_policy_exhausted(c, now, true);
+                if let Some(c) = self.inflight_queue.get_mut(tsn) {
+                    c.retransmit = true;
+                }
                 lost += 1;
+                if !exhausted {
+                    lost_retransmittable += 1;
+                }
             } else {
                 earliest = Some(earliest.map_or(deadline, |e: Instant| e.min(deadline)));
             }
@@ -3460,7 +3468,11 @@ impl Association {
         if lost > 0 {
             self.rack.lost_marked += lost as u64;
             self.t3_retransmit_pending = true;
-            if !self.in_fast_recovery {
+            // lagless policy: a lost chunk that will never be resent (unreliable,
+            // retries exhausted / lifetime expired) is abandoned via FORWARD-TSN
+            // and does not shrink cwnd. Random loss on fire-and-forget game state
+            // then stops throttling the association; reliable loss still does.
+            if lost_retransmittable > 0 && !self.in_fast_recovery {
                 // RFC 8985 9.3 / RFC 9260 7.2.3: one cwnd reduction per recovery episode
                 self.in_fast_recovery = true;
                 self.fast_recover_exit_point = self.my_next_tsn.wrapping_sub(1);
diff --git a/rtc-sctp/src/endpoint/endpoint_test.rs b/rtc-sctp/src/endpoint/endpoint_test.rs
index f0f757d..5512f65 100644
--- a/rtc-sctp/src/endpoint/endpoint_test.rs
+++ b/rtc-sctp/src/endpoint/endpoint_test.rs
@@ -4044,3 +4044,52 @@ fn rack_lost_retransmission_recovers() -> Result<()> {
     assert!(with < without, "rack={with:?} classic={without:?}");
     Ok(())
 }
+
+/// Sends 3 messages, drops the first packet (too few for classic 3-dup-SACK
+/// fast retransmit), and reports whether RACK cut the congestion window.
+fn rack_loss_cuts_cwnd(rel: ReliabilityType, val: u32) -> Result<bool> {
+    let si = 1u16;
+    let (mut pair, client_ch, server_ch) = rack_pair(true, 50)?;
+    pair.server_conn_mut(server_ch).ack_mode = AckMode::NoDelay;
+    establish_session_pair(&mut pair, client_ch, server_ch, si)?;
+    pair.client_stream(client_ch, si)?.set_reliability_params(true, rel, val)?;
+    for k in 0..4 {
+        rack_write(&mut pair, client_ch, si, 100 + k)?;
+        pair.drive();
+        pair.time += Duration::from_millis(20);
+    }
+    let ssthresh_before = pair.client_conn_mut(client_ch).ssthresh;
+    let mut first = true;
+    for k in 0..3 {
+        rack_write(&mut pair, client_ch, si, k)?;
+        pair.client.drive(pair.time, pair.server.addr);
+        if first {
+            pair.client.outbound.clear();
+            first = false;
+        }
+        pair.drive_client();
+        pair.drive_server();
+        pair.time += Duration::from_millis(5);
+    }
+    let end = pair.time + Duration::from_millis(800); // before T3 (1 s RTO min)
+    while pair.time < end {
+        if !pair.step() {
+            pair.time += Duration::from_millis(1);
+        }
+    }
+    let c = pair.client_conn_mut(client_ch);
+    assert!(c.rack.lost_marked > 0, "RACK should have detected the loss");
+    Ok(c.ssthresh != ssthresh_before)
+}
+
+#[test]
+fn rack_unreliable_loss_does_not_cut_cwnd() -> Result<()> {
+    assert!(!rack_loss_cuts_cwnd(ReliabilityType::Rexmit, 0)?, "maxRetransmits=0 loss must not cut cwnd");
+    Ok(())
+}
+
+#[test]
+fn rack_reliable_loss_cuts_cwnd() -> Result<()> {
+    assert!(rack_loss_cuts_cwnd(ReliabilityType::Reliable, 0)?, "reliable loss must cut cwnd");
+    Ok(())
+}
