From caad072dce864553d3ed3b3134655947ae414fea Mon Sep 17 00:00:00 2001
From: Stas Darevskiy <stas@stas.gg>
Date: Sun, 22 Nov 2026 20:59:18 +0000
Subject: [PATCH 4/4] rtc-sctp/rtc: expose live SCTP sender state for
 application pacing

Association::transport_stats() (srtt, rto, RACK min RTT, cwnd, ssthresh,
rwnd, mtu, in-flight/pending bytes, total acked bytes, recovery flag, RACK
lost/probe counts, T3 and fast-rtx counts) and
RTCPeerConnection::sctp_transport_stats().
---
 rtc-sctp/src/association/mod.rs   | 60 +++++++++++++++++++++++++++++++
 rtc-sctp/src/association/stats.rs |  4 +--
 rtc-sctp/src/lib.rs               |  2 +-
 src/peer_connection/mod.rs        | 11 ++++++
 4 files changed, 74 insertions(+), 3 deletions(-)

diff --git a/rtc-sctp/src/association/mod.rs b/rtc-sctp/src/association/mod.rs
index 346838b..80c335e 100644
--- a/rtc-sctp/src/association/mod.rs
+++ b/rtc-sctp/src/association/mod.rs
@@ -139,6 +139,41 @@ const WC_DEL_ACK_MS: u64 = 200;
 /// Window for the RACK min-RTT filter.
 const RACK_MIN_RTT_WINDOW: Duration = Duration::from_secs(30);
 
+/// Live sender-side state of an association (see [`Association::transport_stats`]).
+#[derive(Debug, Default, Clone, Copy)]
+pub struct TransportStats {
+    /// smoothed RTT (ms)
+    pub srtt_ms: u64,
+    /// current retransmission timeout (ms)
+    pub rto_ms: u64,
+    /// windowed minimum RTT (RACK filter), when RACK is enabled
+    pub min_rtt_ms: Option<u64>,
+    /// congestion window (bytes)
+    pub cwnd: u32,
+    /// slow-start threshold (bytes)
+    pub ssthresh: u32,
+    /// peer receive window (bytes)
+    pub rwnd: u32,
+    /// path MTU budget (bytes)
+    pub mtu: u32,
+    /// user bytes sent and not yet acked/abandoned
+    pub inflight_bytes: usize,
+    /// user bytes queued, not yet sent
+    pub pending_bytes: usize,
+    /// total user bytes acked by the peer
+    pub acked_bytes_total: u64,
+    /// in a loss-recovery episode
+    pub in_fast_recovery: bool,
+    /// chunks RACK marked lost
+    pub rack_lost: u64,
+    /// tail loss probes sent
+    pub rack_probes: u64,
+    /// T3-rtx timeouts
+    pub t3_timeouts: u64,
+    /// classic fast retransmissions
+    pub fast_retrans: u64,
+}
+
 /// RACK-TLP sender state (RFC 8985).
 #[derive(Debug, Default, Clone)]
 pub(crate) struct RackState {
@@ -269,6 +304,8 @@ pub struct Association {
     /// RACK-TLP (RFC 8985) enabled for this association.
     pub(crate) rack_enabled: bool,
     pub(crate) rack: RackState,
+    /// total user bytes acknowledged by the peer (delivery-rate signal)
+    pub(crate) acked_bytes_total: u64,
     fast_recover_exit_point: u32,
 
     // Chunks stored for retransmission
@@ -366,6 +403,7 @@ impl Default for Association {
             in_fast_recovery: false,
             rack_enabled: false,
             rack: RackState::default(),
+            acked_bytes_total: 0,
             fast_recover_exit_point: 0,
 
             // Chunks stored for retransmission
@@ -636,6 +674,27 @@ impl Association {
         }
     }
 
+    /// Live sender-side transport state, for application pacing.
+    pub fn transport_stats(&self) -> TransportStats {
+        TransportStats {
+            srtt_ms: self.rto_mgr.srtt,
+            rto_ms: self.rto_mgr.get_rto(),
+            min_rtt_ms: self.rack.min_rtt().map(|d| d.as_millis() as u64),
+            cwnd: self.cwnd,
+            ssthresh: self.ssthresh,
+            rwnd: self.rwnd,
+            mtu: self.mtu,
+            inflight_bytes: self.inflight_queue.get_num_bytes(),
+            pending_bytes: self.pending_queue.get_num_bytes(),
+            acked_bytes_total: self.acked_bytes_total,
+            in_fast_recovery: self.in_fast_recovery,
+            rack_lost: self.rack.lost_marked,
+            rack_probes: self.rack.probes,
+            t3_timeouts: self.stats.n_t3timeouts,
+            fast_retrans: self.stats.n_fast_retrans,
+        }
+    }
+
     /// Returns Association statistics
     pub fn stats(&self) -> AssociationStats {
         self.stats
@@ -1517,6 +1576,7 @@ impl Association {
         // Process selective ack
         let (bytes_acked_per_stream, total_bytes_acked, htna) =
             self.process_selective_ack(d, now)?;
+        self.acked_bytes_total += total_bytes_acked.max(0) as u64;
 
         let mut cum_tsn_ack_point_advanced = false;
         if sna32lt(self.cumulative_tsn_ack_point, d.cumulative_tsn_ack) {
diff --git a/rtc-sctp/src/association/stats.rs b/rtc-sctp/src/association/stats.rs
index f9819da..3c2eba2 100644
--- a/rtc-sctp/src/association/stats.rs
+++ b/rtc-sctp/src/association/stats.rs
@@ -3,9 +3,9 @@
 pub struct AssociationStats {
     n_datas: u64,
     n_sacks: u64,
-    n_t3timeouts: u64,
+    pub(crate) n_t3timeouts: u64,
     n_ack_timeouts: u64,
-    n_fast_retrans: u64,
+    pub(crate) n_fast_retrans: u64,
 }
 
 impl AssociationStats {
diff --git a/rtc-sctp/src/lib.rs b/rtc-sctp/src/lib.rs
index 656c57e..c91f00a 100644
--- a/rtc-sctp/src/lib.rs
+++ b/rtc-sctp/src/lib.rs
@@ -57,7 +57,7 @@ use std::{fmt, ops};
 
 mod association;
 pub use crate::association::{
-    Association, AssociationError, Event,
+    Association, AssociationError, Event, TransportStats,
     stats::AssociationStats,
     stream::{ReliabilityType, Stream, StreamEvent, StreamId, StreamState},
     timer::TimerConfig,
diff --git a/src/peer_connection/mod.rs b/src/peer_connection/mod.rs
index f795b5d..6f18808 100644
--- a/src/peer_connection/mod.rs
+++ b/src/peer_connection/mod.rs
@@ -2475,6 +2475,17 @@ impl RTCPeerConnection {
     ///
     /// See [getStats](https://www.w3.org/TR/webrtc/#widl-RTCPeerConnection-getStats-Promise-RTCStatsReport--MediaStreamTrack-selector) and
     /// [The stats selection algorithm](https://www.w3.org/TR/webrtc/#the-stats-selection-algorithm)
+    /// Live SCTP sender state of the data-channel association (lagless fork):
+    /// srtt, min RTT, cwnd, in-flight/pending bytes, acked bytes. `None` before
+    /// the association exists.
+    pub fn sctp_transport_stats(&self) -> Option<::sctp::TransportStats> {
+        self.sctp_transport()
+            .sctp_associations
+            .values()
+            .next()
+            .map(|a| a.transport_stats())
+    }
+
     pub fn get_stats(&mut self, now: Instant, selector: StatsSelector) -> RTCStatsReport {
         // Update ICE agent stats before taking snapshot
         self.update_ice_agent_stats(now);
