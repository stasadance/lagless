---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/stasadance/lagless";

const site = "https://stasadance.github.io/lagless/";
const title = "lagless: WebRTC data channels for io games, no ping spikes";
const description =
    "Low-latency WebRTC data channels for real-time games, in Rust for Node.js. Ping stays near the RTT even at 5% packet loss.";

const features = [
    {
        title: "True send queue",
        body: "Stack queue, in-flight bytes, cwnd, srtt and min RTT straight from the SCTP association. No hidden buffer.",
    },
    {
        title: "Drop on backpressure",
        body: "Unreliable send() returns false when it wasn't queued. Keep the state owed and send fresher state next tick.",
    },
    {
        title: "RACK-TLP",
        body: "RFC 8985 loss recovery patched into rtc-sctp, so a lost packet doesn't wait for a 1 s retransmission timeout.",
    },
    {
        title: "Per-peer pacer",
        body: "A delay-based budget keeps the network queue near zero. Reliable goes first, unreliable fills the rest.",
    },
    {
        title: "Honest pings",
        body: "Probe messages skip the drop gate, so ping measures the real queue instead of hiding it.",
    },
    {
        title: "Rust core, Node API",
        body: "A napi-rs binding over the webrtc-rs rtc sans-IO core, with a node-datachannel style API and batched drain.",
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={site} />
        <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
        <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="lagless" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={site} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <div class="glow" aria-hidden="true"></div>
        <header class="nav">
            <a href={`${base}/`} class="brand">lagless</a>
            <nav>
                <a href={`${base}/docs/`}>Docs</a>
                <a href={`${base}/docs/benchmarks/`}>Benchmarks</a>
                <a href={repo} class="gh">GitHub</a>
            </nav>
        </header>

        <main>
            <section class="hero">
                <h1>
                    5% packet loss,
                    <br />
                    <span class="grad">no ping spikes.</span>
                </h1>
                <p class="lede">
                    lagless is a Node.js module for fast WebRTC data channels in io games. Rust
                    under the hood, built to keep ping near the real RTT on bad connections.
                </p>
                <div class="stats">
                    <div>
                        <span class="num">13.6 s</span>
                        <span class="lbl">node-datachannel ping p50</span>
                    </div>
                    <div>
                        <span class="num grad">209 ms</span>
                        <span class="lbl">lagless ping p50</span>
                    </div>
                    <div>
                        <span class="num grad">354 ms</span>
                        <span class="lbl">lagless ping p95</span>
                    </div>
                </div>
                <p class="platforms">200 ms RTT, 5% loss both ways, headless Chrome client</p>
                <div class="cta">
                    <a class="btn primary" href={`${base}/docs/`}>Read the docs</a>
                    <a class="btn" href={`${base}/docs/benchmarks/`}>See the benchmarks</a>
                </div>
                <p class="platforms">Pre-release. Not on npm yet.</p>
            </section>

            <section class="features">
                {features.map((f) => (
                    <article>
                        <h3>{f.title}</h3>
                        <p>{f.body}</p>
                    </article>
                ))}
            </section>

            <section class="config">
                <div>
                    <h2>Send fresh, never stale</h2>
                    <p>
                        <code>send()</code> tells you when unreliable state wasn't queued. Keep it
                        owed, and next tick send the newest version instead of piling up old
                        snapshots behind a lost packet.
                    </p>
                    <a href={`${base}/docs/api/`}>API reference →</a>
                </div>
                <pre><code><span class="c">// every tick, per player</span>
<span class="k">for</span> (<span class="k">const</span> m <span class="k">of</span> server.drain()) onMessage(m);

server.send(peer, <span class="s">"r"</span>, events);
<span class="k">if</span> (!server.send(peer, <span class="s">"u"</span>, snapshot())) {"{"}
  owed.add(peer); <span class="c">// resend fresher state next tick</span>
{"}"}</code></pre>
            </section>
        </main>

        <footer>
            <p>
                Built on <a href="https://github.com/webrtc-rs/rtc">webrtc-rs rtc</a> and{" "}
                <a href="https://napi.rs">napi-rs</a>.
            </p>
        </footer>
    </body>
</html>

<style is:global>
    :root {
        --bg: #09080b;
        --fg: #f4f4f6;
        --muted: #a19fab;
        --line: #24212b;
        --card: #121016;
        --pink: #f81ce5;
        --violet: #7b5cff;
        color-scheme: dark;
    }
    * {
        box-sizing: border-box;
    }
    html,
    body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
    }
    body {
        font:
            16px/1.6 Inter,
            system-ui,
            sans-serif;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
    }
    a {
        color: inherit;
    }
    code,
    pre {
        font-family: "JetBrains Mono", ui-monospace, monospace;
    }
</style>

<style>
    .glow {
        position: absolute;
        inset: -20vh 0 auto;
        height: 90vh;
        pointer-events: none;
        background:
            radial-gradient(40% 50% at 30% 30%, rgba(248, 28, 229, 0.22), transparent 70%),
            radial-gradient(40% 50% at 70% 25%, rgba(123, 92, 255, 0.25), transparent 70%);
        filter: blur(20px);
    }
    .nav {
        position: relative;
        max-width: 1200px;
        margin: 0 auto;
        padding: 20px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .nav nav {
        display: flex;
        gap: 24px;
        font-size: 15px;
    }
    .nav nav a {
        text-decoration: none;
        color: var(--muted);
    }
    .nav nav a:hover {
        color: var(--fg);
    }
    .brand {
        font-weight: 700;
        font-size: 22px;
        letter-spacing: -0.02em;
        text-decoration: none;
    }
    .stats {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
        margin: 0 auto;
    }
    .stats div {
        min-width: 160px;
        padding: 16px 20px;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        display: flex;
        flex-direction: column;
    }
    .stats .num {
        font-size: 32px;
        font-weight: 700;
        letter-spacing: -0.02em;
    }
    .stats .lbl {
        color: var(--muted);
        font-size: 14px;
    }
    main {
        position: relative;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 16px;
    }
    .hero {
        text-align: center;
        padding: 72px 0 40px;
    }
    h1 {
        font-size: clamp(32px, 8.5vw, 76px);
        line-height: 1.05;
        letter-spacing: -0.03em;
        margin: 0 0 20px;
        font-weight: 700;
    }
    .grad {
        background: linear-gradient(90deg, var(--pink), var(--violet));
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }
    .lede {
        max-width: 620px;
        margin: 0 auto 32px;
        color: var(--muted);
        font-size: 18px;
    }
    .cta {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }
    .btn {
        padding: 12px 22px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        border: 1px solid var(--line);
        background: var(--card);
    }
    .btn:hover {
        border-color: #3a3642;
    }
    .btn.primary {
        border: 0;
        background: linear-gradient(90deg, var(--pink), var(--violet));
        color: #fff;
    }
    .btn.primary:hover {
        filter: brightness(1.1);
    }
    .install {
        max-width: 560px;
        margin: 0 auto 24px;
        text-align: left;
    }
    .os-tabs {
        display: flex;
        gap: 4px;
        margin-bottom: 8px;
        justify-content: center;
    }
    .os-tabs button {
        font: inherit;
        font-size: 13px;
        color: var(--muted);
        background: none;
        border: 0;
        padding: 4px 10px;
        border-radius: 6px;
        cursor: pointer;
    }
    .os-tabs button[aria-selected="true"] {
        color: var(--fg);
        background: var(--card);
    }
    .cmd {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 12px 12px 16px;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 10px;
    }
    .cmd code {
        flex: 1;
        min-width: 0;
        font-size: 14px;
        white-space: nowrap;
        overflow-x: auto;
        display: none;
    }
    .install[data-os="unix"] [data-for="unix"],
    .install[data-os="windows"] [data-for="windows"] {
        display: block;
    }
    .prompt {
        color: var(--muted);
        user-select: none;
        margin-right: 8px;
    }
    .copy {
        font: inherit;
        font-size: 13px;
        font-weight: 600;
        color: var(--fg);
        cursor: pointer;
        background: none;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 4px 10px;
    }
    .copy:hover {
        border-color: #3a3642;
    }
    .platforms {
        color: var(--muted);
        font-size: 14px;
        margin: 16px 0 56px;
    }
    .shot img {
        width: 100%;
        height: auto;
        border-radius: 12px;
        box-shadow:
            0 40px 120px -20px rgba(123, 92, 255, 0.45),
            0 0 0 1px rgba(255, 255, 255, 0.06);
    }
    .features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 16px;
        padding: 64px 0;
    }
    .features article {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 24px;
    }
    .features h3 {
        margin: 0 0 8px;
        font-size: 18px;
    }
    .features p {
        margin: 0;
        color: var(--muted);
    }
    .config {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 40px;
        align-items: center;
        padding: 32px 0 96px;
    }
    .config > * {
        min-width: 0;
    }
    .config h2 {
        font-size: 32px;
        letter-spacing: -0.02em;
        margin: 0 0 12px;
    }
    .config p {
        color: var(--muted);
    }
    .config a {
        color: #c9a8ff;
        text-decoration: none;
        font-weight: 600;
    }
    .config pre {
        margin: 0;
        padding: 24px;
        border-radius: 14px;
        background: var(--card);
        border: 1px solid var(--line);
        font-size: 14px;
        line-height: 1.7;
        overflow-x: auto;
    }
    .config code {
        font-size: 0.9em;
    }
    .c {
        color: #6b6875;
    }
    .k {
        color: #ff8fe9;
    }
    .s {
        color: #b5f4a5;
    }
    .n {
        color: #c9a8ff;
    }
    .support {
        text-align: center;
        max-width: 720px;
        margin: 0 auto 96px;
        padding: 40px 24px;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 14px;
    }
    .support h2 {
        font-size: 32px;
        letter-spacing: -0.02em;
        margin: 0 0 12px;
    }
    .support p {
        color: var(--muted);
        margin: 0 auto 24px;
        max-width: 560px;
    }
    .support .btn {
        display: inline-block;
    }
    footer {
        border-top: 1px solid var(--line);
        text-align: center;
        color: var(--muted);
        font-size: 14px;
        padding: 32px 16px;
    }
    @media (max-width: 600px) {
        .nav {
            gap: 12px;
        }
        .nav nav {
            gap: 14px;
            font-size: 14px;
        }
        .cmd code {
            font-size: 13px;
            white-space: normal;
            overflow-wrap: anywhere;
        }
        .hero {
            padding-top: 40px;
        }
    }
</style>
