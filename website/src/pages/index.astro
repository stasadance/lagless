---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/stasadance/lagless";

const site = "https://stasadance.github.io/lagless/";
const title = "lagless: WebRTC data channels for io games, no ping spikes";
const description =
    "Low-latency WebRTC data channels for real-time games, in Rust for Node.js. Ping stays near the RTT even at 5% packet loss.";

const features = [
    {
        title: "True send queue",
        body: "Stack queue, in-flight bytes, cwnd, srtt and min RTT come straight from the SCTP association. No hidden buffer.",
    },
    {
        title: "Drop on backpressure",
        body: "Unreliable send() returns false when it wasn't queued. Keep the state owed and send fresher state next tick.",
    },
    {
        title: "RACK-TLP",
        body: "RFC 8985 loss recovery patched into rtc-sctp, so a lost packet doesn't wait for a 1 s retransmission timeout.",
    },
    {
        title: "Per-peer pacer",
        body: "A delay-based budget keeps the network queue near zero. Reliable goes first, unreliable fills the rest.",
    },
    {
        title: "Honest pings",
        body: "Probe messages skip the drop gate, so ping measures the real queue instead of hiding it.",
    },
    {
        title: "Rust core, Node API",
        body: "A napi-rs binding over the webrtc-rs rtc sans-IO core, with a typed TypeScript API on top.",
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={site} />
        <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
        <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="lagless" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={site} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;800&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <div class="page">
            <header class="nav">
                <a href={`${base}/`} class="brand">
                    <img src={`${base}/favicon.svg`} alt="" width="28" height="28" />
                    lagless
                </a>
                <nav>
                    <a href={`${base}/docs/`}>Docs</a>
                    <a href={`${base}/docs/benchmarks/`}>Benchmarks</a>
                    <a href={repo}>GitHub</a>
                </nav>
            </header>

            <main>
                <section class="hero">
                    <h1>Same 5% loss.<br />One of these is lagless.</h1>
                    <p class="lede">
                        WebRTC data channels for io games, with a Rust core and a Node.js API. Ping
                        stays near the real round trip when the connection drops packets.
                    </p>
                    <div class="lanes">
                        <div class="lane old">
                            <span class="name">classic SCTP</span>
                            <div class="track"><div class="dot" id="d-old"></div></div>
                            <span class="ms">12.6 s</span>
                        </div>
                        <div class="lane new">
                            <span class="name">lagless</span>
                            <div class="track"><div class="dot" id="d-new"></div></div>
                            <span class="ms">214 ms</span>
                        </div>
                    </div>
                    <p class="note">
                        Ping p50 at 200 ms RTT and 5% loss, server to client (client to server is the browser's own SCTP).{" "}
                        <a href={`${base}/docs/benchmarks/`}>Full setup</a>
                    </p>
                    <div class="btns">
                        <a class="btn p" href={`${base}/docs/`}>Get started</a>
                        <a class="btn" href={`${base}/docs/benchmarks/`}>Benchmarks</a>
                    </div>
                    <p class="status"><code>pnpm add lagless</code></p>
                </section>

                <section class="features">
                    {features.map((f) => (
                        <article>
                            <h2>{f.title}</h2>
                            <p>{f.body}</p>
                        </article>
                    ))}
                </section>

                <section class="code">
                    <div>
                        <h2>Send fresh, never stale</h2>
                        <p>
                            <code>send()</code> tells you when unreliable state wasn't queued. Keep
                            it owed, and next tick send the newest version instead of piling up old
                            snapshots behind a lost packet.
                        </p>
                        <a href={`${base}/docs/api/`}>API reference →</a>
                    </div>
                    <pre><code><span class="c">// every tick, per player</span>
server.send(peer, <span class="s">"reliable"</span>, events);
<span class="k">for</span> (<span class="k">const</span> snap <span class="k">of</span> snapshots) {"{"}
  <span class="k">if</span> (!server.send(peer, <span class="s">"state"</span>, snap)) <span class="k">break</span>;
  <span class="c">// dropped: send fresher state next tick</span>
{"}"}</code></pre>
                </section>
            </main>

            <script>
                const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
                const o = document.getElementById("d-old")!;
                const n = document.getElementById("d-new")!;
                const place = (el: HTMLElement, f: number) =>
                    (el.style.left = `calc(${f} * (100% - 24px))`);
                place(o, 0.42);
                place(n, 0.78);
                if (!still) {
                    const t0 = performance.now();
                    let oldPos = 0;
                    let nextJump = 0;
                    const tick = (t: number) => {
                        const f = ((t - t0) / 4000) % 1;
                        place(n, f);
                        if (f < 0.02) oldPos = 0;
                        else if (t > nextJump) {
                            oldPos = f;
                            nextJump = t + 600 + Math.random() * 1400;
                        }
                        place(o, oldPos);
                        requestAnimationFrame(tick);
                    };
                    requestAnimationFrame(tick);
                }
            </script>

            <footer>
                Built on <a href="https://github.com/webrtc-rs/rtc">webrtc-rs rtc</a> and{" "}
                <a href="https://napi.rs">napi-rs</a>.
            </footer>
        </div>
    </body>
</html>

<style is:global>
    :root {
        --bg: #eef2f7;
        --ink: #1238c4;
        --fg: #0c1633;
        --dim: #5a6580;
        --rule: #c4cfe3;
        --code: #e2e8f2;
        --track: #dbe3f3;
        --card: #f7f9fc;
        --bad: #c2412d;
        --sans: "IBM Plex Sans", system-ui, sans-serif;
        --mono: "IBM Plex Mono", ui-monospace, monospace;
        --display: "Archivo", "IBM Plex Sans", system-ui, sans-serif;
        color-scheme: light;
    }
    @media (prefers-color-scheme: dark) {
        :root {
            --bg: #0a1024;
            --ink: #7f9bff;
            --fg: #e6ebf7;
            --dim: #8f9bb8;
            --rule: #1f2a4d;
            --code: #111a36;
            --track: #16214a;
            --card: #0f1730;
            --bad: #ff8a73;
            color-scheme: dark;
        }
    }
    * {
        box-sizing: border-box;
    }
    html,
    body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
    }
    body {
        font: 16px/1.6 var(--sans);
        -webkit-font-smoothing: antialiased;
    }
    a {
        color: var(--ink);
    }
    code,
    pre {
        font-family: var(--mono);
    }
</style>

<style>
    .page {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 max(16px, env(safe-area-inset-left, 0px));
    }
    .nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding: 20px 0 12px;
        border-bottom: 2px solid var(--ink);
    }
    .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font: 800 22px var(--display);
        color: var(--fg);
        text-decoration: none;
        letter-spacing: -0.02em;
    }
    .nav nav {
        display: flex;
        gap: 20px;
        font: 14px var(--mono);
    }
    .nav nav a {
        color: var(--dim);
        text-decoration: none;
    }
    .nav nav a:hover {
        color: var(--ink);
    }
    .hero {
        padding: 72px 0 56px;
        border-bottom: 1px solid var(--rule);
    }
    h1 {
        font: 900 clamp(36px, 6.5vw, 68px) / 1 var(--display);
        letter-spacing: -0.03em;
        margin: 0 0 16px;
        text-wrap: balance;
    }
    .lede {
        color: var(--dim);
        font-size: 18px;
        max-width: 52ch;
        margin: 0;
    }
    .lanes {
        display: grid;
        gap: 14px;
        margin: 40px 0 12px;
    }
    .lane {
        display: grid;
        grid-template-columns: minmax(96px, 160px) 1fr auto;
        gap: 16px;
        align-items: center;
        font: 14px var(--mono);
    }
    .lane > * {
        min-width: 0;
    }
    .track {
        position: relative;
        height: 34px;
        background: var(--track);
        border-radius: 17px;
        overflow: hidden;
    }
    .dot {
        position: absolute;
        top: 5px;
        left: 0;
        width: 24px;
        height: 24px;
        border-radius: 50%;
    }
    .old .dot {
        background: var(--bad);
    }
    .new .dot {
        background: var(--ink);
    }
    .ms {
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        min-width: 64px;
        text-align: right;
    }
    .old .ms {
        color: var(--bad);
    }
    .new .ms {
        color: var(--ink);
    }
    .note {
        font: 13px var(--mono);
        color: var(--dim);
        margin: 0 0 32px;
    }
    .btns {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }
    .btn {
        font: 600 15px var(--sans);
        padding: 11px 20px;
        border-radius: 8px;
        text-decoration: none;
        border: 1.5px solid var(--ink);
        color: var(--ink);
    }
    .btn.p {
        background: var(--ink);
        color: var(--bg);
    }
    .status {
        margin: 20px 0 0;
        font: 13px var(--mono);
        color: var(--dim);
    }
    .features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 16px;
        padding: 56px 0;
        border-bottom: 1px solid var(--rule);
    }
    .features article {
        background: var(--card);
        border: 1px solid var(--rule);
        border-radius: 12px;
        padding: 24px;
    }
    .features h2 {
        font: 800 20px var(--display);
        margin: 0 0 8px;
        letter-spacing: -0.01em;
    }
    .features p {
        margin: 0;
        color: var(--dim);
    }
    .code {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 40px;
        align-items: center;
        padding: 64px 0 80px;
    }
    .code > * {
        min-width: 0;
    }
    .code h2 {
        font: 800 32px var(--display);
        letter-spacing: -0.02em;
        margin: 0 0 12px;
    }
    .code p {
        color: var(--dim);
    }
    .code > div > a {
        font-weight: 600;
        text-decoration: none;
    }
    pre {
        margin: 0;
        padding: 24px;
        background: var(--code);
        border-left: 3px solid var(--ink);
        font-size: 14px;
        line-height: 1.7;
        overflow-x: auto;
    }
    .c {
        color: var(--dim);
    }
    .k {
        color: var(--ink);
        font-weight: 600;
    }
    .s {
        color: var(--bad);
    }
    footer {
        border-top: 2px solid var(--ink);
        padding: 24px 0 40px;
        font: 13px var(--mono);
        color: var(--dim);
    }
    @media (max-width: 600px) {
        .lane {
            grid-template-columns: 1fr auto;
            row-gap: 6px;
        }
        .track {
            grid-column: 1 / -1;
            grid-row: 2;
        }
        .hero {
            padding: 40px 0;
        }
    }
</style>
